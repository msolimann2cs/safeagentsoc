{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safeagentsoc.local/schemas/alert_role.schema.json",
  "title": "SafeAgentSOC Runtime Alert Role",
  "type": "object",
  "additionalProperties": false,
  "required": ["runtime_alert_role", "role_confidence", "role_reason", "role_features"],
  "properties": {
    "runtime_alert_role": {
      "type": "string",
      "enum": ["trigger", "supporting", "duplicate", "noise", "context", "unrelated"]
    },
    "role_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "role_reason": { "type": "string" },
    "role_features": { "type": "array", "items": { "type": "string" } }
  }
}

