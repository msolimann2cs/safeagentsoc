    "object_id": {"type": "string"},
    "decision": {"type": "string"},
    "reason": {"type": "string"},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "input_hash": {"type": "string"},
    "output_hash": {"type": "string"},
    "created_at_utc": {"type": "string"}
  },
  "additionalProperties": true
}
