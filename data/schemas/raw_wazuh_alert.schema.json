{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SafeAgentSOC Phase 2 Raw Wazuh Alert Reference Schema",
  "type": "object",
  "required": ["timestamp", "agent", "rule"],
  "properties": {
    "timestamp": { "type": "string" },
    "agent": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "id": { "type": "string" },
        "ip": { "type": "string" }
      }
    },
    "rule": {
      "type": "object",
      "properties": {
        "id": { "type": ["string", "number"] },
        "level": { "type": ["integer", "number"] },
        "description": { "type": "string" },
        "groups": { "type": "array" }
      }
    },
    "full_log": { "type": "string" },
    "location": { "type": "string" },
    "data": { "type": "object" }
  },
  "additionalProperties": true
}

